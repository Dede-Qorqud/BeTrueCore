pragma solidity ^0.8.24;

/*
 * ═════════════════════════════════════════════════════════════════════════════
 * BeTrueCore — NINNullifierRegistry.sol
 * On-chain registry for ZK identity proofs
 *
 * Author:  Farman Guliyev (Safarnur)
 * ORCID:   0009-0004-4841-594X
 * GitHub:  github.com/Dede-Qorqud/BeTrueCore
 * Version: 0.1 — MVP Contract
 * ═════════════════════════════════════════════════════════════════════════════
 *
 * PURPOSE
 * ───────
 * This contract is the on-chain counterpart to NINIdentityProof.circom.
 * It stores:
 *   1. The Merkle root of the registered voter tree
 *   2. Which nullifiers have been used (per session)
 *
 * And verifies:
 *   - A valid Groth16 ZK proof (via the generated Verifier.sol)
 *   - That the nullifier has not been used before in this session
 *
 * CRITICAL PROPERTY: The NIN code itself NEVER appears anywhere in this
 * contract, in any transaction, or in any event. The contract only ever
 * sees: merkle_root, session_id, nullifier, and the Groth16 proof bytes.
 *
 * What the network sees, which is a different question (audit lens B5): the
 * same set, earlier, and alongside the address that sent it. Arguments travel
 * the peer-to-peer network in the open before any block holds them, and that
 * includes the calls a block never holds — proofs rejected, replaced, or made
 * stale by a root change. Those leave no trace in the chain and are kept by
 * anyone who was watching. The NIN stays out of all of it; the timing and the
 * sender do not.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * INTEGRATION WITH BeTrueCore ARCHITECTURE:
 *
 *   L0 (Identity)  — NIN + Web3Auth MPC → commitment (client-side). The
 *                    gateway check that makes the NIN a confirmed number runs
 *                    in the client and is bound to nothing here: this contract
 *                    receives a root and never learns what the leaves under it
 *                    were built from. See NINCommitment.circom, "what this
 *                    circuit proves and what it does not".
 *   L1 (Proofs)    ← THIS CONTRACT and Poll.sol — the proof layer:
 *                    Poll.joinPoll calls verifyAndRegister before a
 *                    participant may publish anything
 *   L2 (Execution) — BeTrueCoreCore.sol — session lifecycle and VWU
 *   L3 (Lock)      — Lit Protocol time-lock, a two-thirds threshold quorum
 *                    on an outside network — external dependency; see the
 *                    note at the coordinator field in Poll.sol (Phase 2)
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * GROTH16 VERIFIER:
 *
 *   The IGroth16Verifier interface below must be implemented by the Verifier.sol
 *   contract generated by snarkjs after the trusted setup:
 *
 *     $ snarkjs groth16 setup NINIdentityProof.r1cs pot15_final.ptau proof_0000.zkey
 *     $ snarkjs zkey contribute proof_0000.zkey proof_0001.zkey --name="BeTrueCore"
 *     $ snarkjs zkey export solidityverifier proof_0001.zkey Verifier.sol
 *
 *   These lines only repeat circuits/COMPILE.md, which is the single source
 *   for the commands and for the ceremony file. They used to name
 *   pot20_final.ptau while the guide names the degree-15 file; the guide
 *   decides, and two documents of one project must not disagree on which is
 *   used. Which degree suffices cannot be stated yet: the circuits have not
 *   been compiled, the constraint count is therefore unknown, and the figure
 *   of 11,951 that stood here was never measured. Read the count from
 *   snarkjs r1cs info on the first build and check it against the ceiling of
 *   the chosen file — degree 15 covers 32,768 constraints. A single
 *   contribution leaves the setup forgeable by the contributor: see the
 *   ceremony note in COMPILE.md before the first real session.
 *
 *   Deploy Verifier.sol first, then pass its address to this constructor.
 *
 * ═════════════════════════════════════════════════════════════════════════════
 */

/// @title IGroth16Verifier
/// @notice Interface for the snarkjs-generated Groth16 verifier contract
/// @dev Generated by: snarkjs zkey export solidityverifier
interface IGroth16Verifier {
    /// @notice Verify a Groth16 proof
    /// @param a      Proof element A  (G1 point)
    /// @param b      Proof element B  (G2 point)
    /// @param c      Proof element C  (G1 point)
    /// @param input  Public signals in the order snarkjs expects, which is the
    ///               order circom lays them out: OUTPUTS FIRST, then public
    ///               inputs in the order they are declared. Read off the source
    ///               of circuits/NINIdentityProof.circom, which declares one
    ///               output and two public inputs in this order:
    ///               [0] = nullifier          (circuit output)
    ///               [1] = merkle_root        (public input)
    ///               [2] = external_nullifier (public input, = session_id)
    ///               The circuits have not been compiled, so this rests on the
    ///               language rule and on the source, not on a symbol file.
    ///               Confirm it against the generated .sym before the verifier
    ///               is deployed.
    /// @return true if proof is valid
    function verifyProof(
        uint256[2]    calldata a,
        uint256[2][2] calldata b,
        uint256[2]    calldata c,
        uint256[3]    calldata input
    ) external view returns (bool);
}


/// @title NINNullifierRegistry
/// @notice On-chain ZK identity proof registry for BeTrueCore
contract NINNullifierRegistry {

    // ══════════════════════════════════════════════════════════════════════
    // STATE
    // ══════════════════════════════════════════════════════════════════════

    /// @notice Order of the scalar field the circuit works over (BN254)
    /// @dev A nullifier is a field element, but it is stored here as bytes32,
    ///      a wider space: n and n + SNARK_SCALAR_FIELD are two spellings of
    ///      one field element. Without the check in verifyAndRegister they
    ///      would be two different keys in the dedup mapping, and one secret
    ///      could enter one session twice. The generated Verifier.sol does
    ///      reject out-of-field public signals today — but that file is
    ///      produced at setup time by whichever snarkjs version the operator
    ///      runs, it is not part of this repository, and nobody here has read
    ///      it. One entry per session must not rest on it.
    uint256 internal constant SNARK_SCALAR_FIELD =
        21888242871839275222246405745257275088548364400416034343698204186575808495617;

    /// @notice Current Merkle root of the registered voter tree
    /// @dev Updated when new citizens are registered
    ///      In production: updated by community governance, not by the
    ///      deploying address
    bytes32 public merkleRoot;

    /// @notice Tracks which nullifiers have been used, per session
    /// @dev nullifiers[session_id][nullifier] = true if already submitted
    ///      Key insight: same nullifier in a new session is allowed
    ///      (different external_nullifier → different circuit output)
    ///
    ///      Not public. A public mapping generates a second getter with the
    ///      same effect as isNullifierUsed, so the same question had two
    ///      doors and the reasoning for answering it stood at one of them.
    ///      One question, one documented door: see isNullifierUsed below.
    mapping(uint256 => mapping(bytes32 => bool)) private nullifiers;

    /// @notice Groth16 verifier contract (generated by snarkjs)
    /// @dev Immutable — changing the verifier requires redeployment
    IGroth16Verifier public immutable verifier;

    /// @notice Address holding the registrar role of this registry
    /// @dev Named for how it begins, not for what it is: the deploying address
    ///      receives the role, and from there the role passes on — REGISTRAR
    ///      HANDOVER below, two steps, through the acting holder alone. It is
    ///      not a standing office. No role in BeTrueCore stands above
    ///      participants: the coordinator and the operator are the community
    ///      itself, and the position on the temporariness of the role is stated
    ///      once, at the coordinator field in Poll.sol.
    ///
    ///      Before lens B8 there was no handover at all, and "replaced by
    ///      community governance" meant redeploying the registry and setting
    ///      its root afresh.
    ///
    ///      What this role can do, stated together rather than at two functions
    ///      (audit lens B8): it writes the Merkle root, which decides who is in
    ///      the set at all, and it repoints the registry at another Poll
    ///      contract. Neither power is constrained by any proof. And it is a
    ///      different address from the coordinator in Poll.sol and in
    ///      BeTrueCoreCore.sol — nothing here requires the two to coincide,
    ///      nothing checks it, and no event pairs them. So the community
    ///      governing the coordinator role says nothing about who governs the
    ///      set of participants. Whether the two roles are held by the same
    ///      community is organisational, and it is to be named as
    ///      organisational wherever the chain of authority is described. The
    ///      boundary is in docs/AUTHORITY_CHAIN.md, §14.
    address public deployer;

    /// @notice Address named to take over the registrar role, not yet in force
    address public pendingDeployer;

    /// @notice Number of times the Merkle root has been updated
    /// @dev Replaces the roots themselves in the log — see MerkleRootUpdated.
    uint256 public rootUpdateCount;

    /// @notice The only contract allowed to call verifyAndRegister
    /// @dev Set by the deployer after Poll.sol is deployed — and changeable
    ///      afterwards, which is why setPoll emits an event. Without it the
    ///      core function is open to everyone, and a proof seen on the network
    ///      before it reaches a block can be replayed by a stranger: the
    ///      nullifier is spent and its rightful owner is turned away.
    address public poll;

    // ══════════════════════════════════════════════════════════════════════
    // EVENTS
    // ══════════════════════════════════════════════════════════════════════

    /// @notice Emitted when the voter Merkle root is updated
    /// @dev The counter only. Publishing the roots themselves, each with its
    ///      own timestamp, hands an observer the exact chronology of
    ///      registrations — no names, but the dates and the number. Set beside
    ///      the IdentityVerified events of later sessions, that chronology
    ///      narrows the circle: in a small community it tells whether a newly
    ///      registered citizen has taken part since. It narrows it in the
    ///      probabilistic sense, not down to one person — a proof against a
    ///      root can come from anyone whose leaf is in that tree.
    event MerkleRootUpdated(uint256 rootUpdateCount);
    
    /// @notice Emitted when a valid ZK identity proof is accepted
    /// @dev It contains NO information about who the participant is.
    ///      It is not the only on-chain record of participation, though:
    ///      Poll.sol emits ParticipantJoined for the same entry, and
    ///      BeTrueCoreCore.sol keeps a second nullifier mapping of its own —
    ///      see the note at verifyAndRegister. All three answer one question
    ///      for anyone holding the nullifier: did its owner enter this
    ///      session. That is the question a coercer demanding abstention
    ///      asks, so the number of places answering it belongs in the open.
    ///      Audit lens B6.
    event IdentityVerified(
        uint256 indexed sessionId,
        bytes32 indexed nullifier,
        uint256 timestamp
    );

    /// @notice Emitted when the contract allowed to call verifyAndRegister
    ///         is set or changed
    /// @dev Discloses nothing new. The current pointer is already readable
    ///      from the public `poll` getter and appears in every call this
    ///      registry accepts. What the event adds is the moment of the
    ///      change — which is exactly what was missing. See setPoll.
    event PollSet(address indexed previousPoll, address indexed newPoll);

    // ══════════════════════════════════════════════════════════════════════
    // ERRORS
    // ══════════════════════════════════════════════════════════════════════

    /// @notice Thrown when the same nullifier enters one session twice
    /// @dev Sybil prevention, stated at the width it actually holds: one
    ///      SECRET = one session entry ticket. The nullifier comes from the
    ///      participant's secret, and the secret is one of the preimages of
    ///      their leaf, so one leaf yields one ticket. Getting from there to
    ///      "one citizen, one ticket" needs each citizen to hold exactly one
    ///      live leaf, and nothing enforces that: the tree is assembled
    ///      off-chain and its root is written by a single address.
    ///      See guarantee 3 in NINIdentityProof.circom.
    ///
    ///      Multiple choice changes within the session are allowed via
    ///      Poll.sol MESSAGE KEY rotation (the MACI key-rotation pattern),
    ///      which is a different mechanism from secret rotation.
    ///      Only the final choice at time lock is counted — what that does
    ///      and does not do against coercion is stated at RECEIPT-FREENESS
    ///      GUARANTEE — AND ITS LIMIT in Poll.sol.
    error NullifierAlreadyUsed(uint256 sessionId, bytes32 nullifier);

    /// @notice Thrown when the Groth16 proof fails verification
    error InvalidZKProof();

    /// @notice Thrown when a nullifier is not a valid field element
    error NullifierOutOfField(bytes32 nullifier);

    /// @notice Thrown when a Merkle root is not a valid field element
    /// @dev The root is a Poseidon output, so an honest one is always in the
    ///      field. This check guards against a mistyped value: the root is
    ///      passed to the verifier as a public signal, and an out-of-field
    ///      signal is refused there — every entry to every session would fail
    ///      until the root is corrected, with nothing naming the cause.
    error RootOutOfField(bytes32 root);

    /// @notice Thrown when caller is not the holder of the registrar role
    error OnlyDeployer();

    /// @notice Thrown when the registrar handover is accepted by another address
    error NotProposedDeployer();

    /// @notice Thrown when verifyAndRegister is called by anyone but Poll.sol
    error OnlyPoll();


    // ══════════════════════════════════════════════════════════════════════
    // CONSTRUCTOR
    // ══════════════════════════════════════════════════════════════════════

    /// @param _verifier     Address of the snarkjs-generated Verifier.sol
    /// @param _initialRoot  Initial Merkle root (empty tree or first batch)
    constructor(address _verifier, bytes32 _initialRoot) {
        require(_verifier != address(0), "Verifier: zero address");

        // The same two checks updateMerkleRoot applies, applied here as well.
        // A root set at deployment carries the same load as one set later:
        // out of field, it is refused by the verifier as a public signal, so
        // every entry to every session fails with nothing naming the cause —
        // the failure RootOutOfField exists to prevent. Zero is not an empty
        // tree either: the root of an empty Poseidon tree is the hash chain of
        // its filler leaves, never zero.
        require(_initialRoot != bytes32(0), "Root: cannot be zero");
        if (uint256(_initialRoot) >= SNARK_SCALAR_FIELD) {
            revert RootOutOfField(_initialRoot);
        }

        verifier    = IGroth16Verifier(_verifier);
        merkleRoot  = _initialRoot;
        deployer    = msg.sender;
    }

    // ══════════════════════════════════════════════════════════════════════
    // REGISTRAR HANDOVER
    //
    // Two steps, the same shape as the handovers in Poll.sol,
    // BeTrueCoreCore.sol, VWUEngine.sol, EthicalMatrix.sol and
    // HarmonyAgent.sol: the acting holder names a successor, and the successor
    // takes the role by its own call, which is how it shows it holds the key. A
    // one-step setter would hand the root-writing power to a mistyped address
    // with no way back. Naming a different address replaces an unaccepted
    // proposal; there is no separate cancel.
    //
    // The cost, stated rather than hidden: if the key is lost, nothing here
    // moves the role, and reaching it means redeploying this registry and
    // setting its root afresh. No address outside the role is given a way
    // round, because such a way is itself the capture surface.
    //
    // What a handover does not change: the successor inherits an unconstrained
    // power. The root is computed off-chain and this contract cannot tell which
    // leaves a new root added, so passing the role passes the same trust to
    // another address rather than reducing it. Only a provable root transition
    // reduces it — see the note at updateMerkleRoot, and the corresponding row
    // in docs/AUTHORITY_CHAIN.md, §14. Both events carry rootUpdateCount, so
    // the archive shows where in the run of root updates the role changed
    // hands. Audit lens B8.
    // ══════════════════════════════════════════════════════════════════════

    /// @notice The acting holder named a successor. Nothing has moved yet.
    event RegistrarHandoverProposed(
        address indexed proposed,
        uint256 rootUpdateCount
    );

    /// @notice The role passed. rootUpdateCount fixes where in the run of root
    ///         updates it happened.
    event RegistrarTransferred(
        address indexed previous,
        address indexed current,
        uint256 rootUpdateCount
    );

    /// @notice Name the address that may take over the registrar role
    function proposeDeployer(address proposed) external {
        if (msg.sender != deployer) revert OnlyDeployer();
        require(proposed != address(0), "Zero address");
        require(proposed != deployer, "Already registrar");

        pendingDeployer = proposed;
        emit RegistrarHandoverProposed(proposed, rootUpdateCount);
    }

    /// @notice Take over the registrar role, called by the named address
    function acceptDeployer() external {
        if (msg.sender != pendingDeployer) revert NotProposedDeployer();

        address previous = deployer;
        deployer         = msg.sender;
        pendingDeployer  = address(0);

        emit RegistrarTransferred(previous, msg.sender, rootUpdateCount);
    }

    // ══════════════════════════════════════════════════════════════════════
    // REGISTRAR
    // ══════════════════════════════════════════════════════════════════════

    /// @notice Update the registered voter Merkle root
    /// @dev Called when a new citizen registers — their commitment
    ///      is added as a leaf and the root is updated off-chain,
    ///      then committed here.
    ///      The line that stood here — replace with multi-sig or Thermostat
    ///      governance — is withdrawn as a remedy, for the reason given in the
    ///      note below: splitting the role changes who may call, not what the
    ///      call proves. "Thermostat governance" named nothing defined
    ///      anywhere in this project.
    ///
    ///      Open, structural — not addressed by this function. The registry
    ///      holds one root and proofs are accepted against it alone, so every
    ///      new registration invalidates proofs already in flight: a
    ///      participant has to recompute, and in practice registration has to
    ///      be frozen for the duration of a session. Holding a window of the
    ///      last N roots and accepting a proof against any of them is the only
    ///      thing that closes this. It is a decision, not an edit.
    ///
    ///      The same shape, read against lens B5, is more than an
    ///      inconvenience. Proofs are visible on the network before they are
    ///      mined, and whoever holds this role is among those who see them.
    ///      Calling this function at that moment makes a proof in flight
    ///      verify against a root it was not built for, and it is refused.
    ///      Nothing in the chain records that this was deliberate: the log
    ///      carries a counter, and the refusal looks like the ordinary
    ///      staleness described above. So the holder of this role can keep a
    ///      chosen entry out of a session, silently, without touching the
    ///      registry's contents. A window of roots closes this together with
    ///      the staleness — one decision, both properties.
    ///
    ///      Read against lens B7, the same function is the door into the
    ///      community. The tree is assembled off-chain and only its root
    ///      reaches this contract, so this call cannot distinguish a root that
    ///      added the commitments of citizens who registered from a root that
    ///      added a leaf nobody chose — the caller's own included. The cost of
    ///      an extra participant is one call of this function, and nothing
    ///      limits how many leaves a single call brings in. The event carries a
    ///      counter, so the chain records that a root changed and never what
    ///      the change contained.
    ///
    ///      Note what the multi-sig line above does NOT buy. Splitting this
    ///      role between several holders changes who may call, not what the
    ///      call proves: an added leaf stays invisible either way, and the same
    ///      holds for community governance. Making an addition auditable needs
    ///      the root transition itself to be provable — the new root shown to
    ///      follow from the old one by inserting exactly the commitments
    ///      declared, with that set published. Until such a proof exists,
    ///      completeness of the participant set rests on trusting whoever
    ///      computes the root, and that must be said wherever the set is
    ///      called closed.
    ///
    /// @param _newRoot  New Merkle root after adding the latest registrations
    function updateMerkleRoot(bytes32 _newRoot) external {
        if (msg.sender != deployer) revert OnlyDeployer();
        require(_newRoot != bytes32(0), "Root: cannot be zero");
        if (uint256(_newRoot) >= SNARK_SCALAR_FIELD) {
            revert RootOutOfField(_newRoot);
        }

        merkleRoot = _newRoot;
        rootUpdateCount++;

        emit MerkleRootUpdated(rootUpdateCount);
    }

    /// @notice Set the contract allowed to call verifyAndRegister
    /// @dev Deployment step: deploy Poll.sol, then point this registry at it.
    ///      Until it is called, verifyAndRegister reverts for everyone.
    ///
    ///      The pointer stays changeable, and that is a standing power, not a
    ///      deployment detail. Repointed in the middle of a session it turns
    ///      every join into OnlyPoll; pointed at a contract of the holder's
    ///      own it makes Guard 0 meaningless. Before this fix the change left
    ///      no trace of any kind — no event, no counter — so the archive
    ///      could not tell a deliberate lockout from an ordinary failure.
    ///      Same shape as the silent refusal described at updateMerkleRoot,
    ///      audit lens B5. The event does not remove the power; it removes
    ///      the silence. Making the pointer one-time is a decision, not an
    ///      edit: it would also mean redeploying this registry whenever
    ///      Poll.sol is replaced.
    /// @param _poll  Address of the deployed Poll.sol
    function setPoll(address _poll) external {
        if (msg.sender != deployer) revert OnlyDeployer();
        require(_poll != address(0), "Poll: zero address");

        emit PollSet(poll, _poll);
        poll = _poll;
    }

    // ══════════════════════════════════════════════════════════════════════
    // CORE — VERIFY AND REGISTER
    // ══════════════════════════════════════════════════════════════════════

    /// @notice Verify a ZK identity proof and register the nullifier
    ///
    /// @dev Called by Poll.sol (L2) before accepting a vote.
    ///      Enforces two guarantees in a single atomic call:
    ///        1. The proof is cryptographically valid
    ///        2. This nullifier has not been used in this session
    ///
    ///      What the contract learns: session_id, nullifier, block timestamp.
    ///      What the contract does NOT learn: who the voter is, their NIN,
    ///      their commitment leaf, or their vote choice.
    ///
    ///      What an observer learns is not the same list. The call reaches
    ///      them before it reaches a block, and the address that sent it comes
    ///      with it — so the nullifier arrives already paired with a wallet,
    ///      whatever this contract does or does not store. Guard 0 below
    ///      keeps a stranger from calling here directly; it does not make the
    ///      arguments unseen, and it does not reach the second nullifier
    ///      registry — the usedNullifiers mapping in BeTrueCoreCore.sol marks
    ///      a nullifier spent for anyone who asks, with no proof and no caller
    ///      check at all. Until the two registries are one, the restriction
    ///      added here is closed at one door and open at the other.
    ///
    /// @param sessionId    Active session ID (= external_nullifier in circuit)
    /// @param nullifier    Nullifier from the ZK proof output
    /// @param zkProof_a    Groth16 proof component A
    /// @param zkProof_b    Groth16 proof component B
    /// @param zkProof_c    Groth16 proof component C
    /// @return             true — always, or reverts
    function verifyAndRegister(
        uint256           sessionId,
        bytes32           nullifier,
        uint256[2]    calldata zkProof_a,
        uint256[2][2] calldata zkProof_b,
        uint256[2]    calldata zkProof_c
     ) external returns (bool) {

        // ── Guard 0: Only Poll.sol may call this ──────────────────────────
        // A proof is a bearer token: it carries no sender signal, so anyone
        // who copies it from the network before it is mined can submit it
        // first. Restricting the caller does not fix that on its own — see
        // joinPoll in Poll.sol — but it removes the cheapest path to it.
        if (msg.sender != poll) revert OnlyPoll();

        // ── Guard 1: Nullifier must be in the field, and fresh here ───────
        // The dedup below is keyed by bytes32 while the circuit works in a
        // smaller field, so two spellings of one nullifier would be two keys
        // and one session could be entered twice. See SNARK_SCALAR_FIELD.
        if (uint256(nullifier) >= SNARK_SCALAR_FIELD) {
            revert NullifierOutOfField(nullifier);
        }

        // A second attempt with the same secret produces the same nullifier
        // (Poseidon(secret, session_id) is deterministic) → rejected here.
        // What this enforces is one entry per SECRET, not one per citizen —
        // see the note at NullifierAlreadyUsed.
        //
        // IMPORTANT: This does NOT prevent choice changes within the session.
        // A citizen who entered with this nullifier can still rotate their
        // choice via Poll.sol until the time lock, up to max_messages — not a
        // bug, a feature. What re-choice buys is narrower than resistance to
        // coercion: an earlier choice becomes unprovable, while being watched
        // at the last change, handing the message key over, and a cap spent
        // under duress all lie outside what it covers. Stated in full at
        // RECEIPT-FREENESS GUARANTEE — AND ITS LIMIT in Poll.sol.
        // Audit lens B6.
        if (nullifiers[sessionId][nullifier]) {
            revert NullifierAlreadyUsed(sessionId, nullifier);
        }

        // ── Guard 2: ZK proof must be valid ──────────────────────────────
        // The order is fixed by the circuit, not chosen here. circom places the
        // outputs before the public inputs and snarkjs keeps that order in the
        // generated verifier. From the source of NINIdentityProof.circom, which
        // declares the output nullifier and then the public inputs merkle_root
        // and external_nullifier:
        //   [0] = nullifier          (circuit output)
        //   [1] = merkle_root        (current on-chain root)
        //   [2] = external_nullifier (= sessionId)
        // Any other order verifies a different statement, and no honestly
        // built proof can satisfy it — every entry would be refused.
        uint256[3] memory publicInputs = [
            uint256(nullifier),
            uint256(merkleRoot),
            sessionId
        ];

        bool valid = verifier.verifyProof(
            zkProof_a,
            zkProof_b,
            zkProof_c,
            publicInputs
        );

        if (!valid) revert InvalidZKProof();

        // ── Register nullifier (prevents future Sybil entry) ─────────────
        // Marks this citizen as "entered the session".
        // Does not lock their choice — Poll.sol key rotation remains open
        // until the Lit Protocol time lock closes the session.
        nullifiers[sessionId][nullifier] = true;

        emit IdentityVerified(sessionId, nullifier, block.timestamp);

        return true;
    }

    // ══════════════════════════════════════════════════════════════════════
    // VIEW
    // ══════════════════════════════════════════════════════════════════════

    /// @notice Check if a nullifier has already been used in a session
    /// @dev Declared in Poll.sol's minimal interface but never called there:
    ///      joinPoll checks its own `joined` mapping instead. Kept for
    ///      external readers. It is open to everyone, and it is read without
    ///      sending anything: whoever holds a nullifier learns whether its
    ///      owner entered this session, at no cost and leaving no record
    ///      anywhere. The IdentityVerified event is indexed by nullifier and
    ///      answers the same question, so this getter discloses nothing the
    ///      log does not — and removes nothing either. What matters for lens
    ///      B5 is the silence of it: sending leaves a trace, reading does not.
    ///      A coercer who demanded "enter while I watch" needs exactly this.
    function isNullifierUsed(
        uint256 sessionId,
        bytes32 nullifier
    ) external view returns (bool) {
        return nullifiers[sessionId][nullifier];
    }

    /// @notice Returns the current Merkle root
    function currentMerkleRoot() external view returns (bytes32) {
        return merkleRoot;
    }
}