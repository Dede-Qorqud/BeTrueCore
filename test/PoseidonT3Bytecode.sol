pragma solidity ^0.8.24;

/// @title PoseidonT3Bytecode
/// @notice Creation bytecode of circomlib's two-input Poseidon, for tests only
/// @dev WHY A BLOB OF BYTECODE IS IN THIS REPOSITORY. CompositionTree hashes
///      with the Poseidon the circuits hash with, and that contract has no
///      Solidity source: circomlib generates its bytecode directly. A
///      reimplementation in Solidity would be a DIFFERENT hash unless proved
///      identical, and then the test would be checking the reimplementation
///      rather than the tree. So the real one is deployed here.
///
///      It is used by tests and by nothing else. contracts/ holds what is
///      deployed; this file sits in test/ because it is a fixture, like
///      test/RegistrationFixtures.sol.
///
///      HOW TO REGENERATE IT, if it ever has to be. With circomlibjs from npm:
///
///          const { poseidonContract } = require('circomlibjs');
///          console.log(poseidonContract.createCode(2));
///
///      That prints the same 9755 bytes. The argument 2 is the number of
///      inputs, which is what IPoseidon2 in CompositionTree.sol expects. The
///      same package also generates the circuits, so the hash the tests check
///      against and the hash the circuits use come from one source.
///
///      HOW TO CHECK IT IS WHAT IT CLAIMS, without trusting this file: deploy
///      it and hash a known pair. test_the_hasher_is_the_poseidon_the_circuits_use
///      in test/CompositionTree.t.sol does exactly that against a value taken
///      from circomlibjs, so a swapped blob fails the suite rather than
///      quietly changing every root.
library PoseidonT3Bytecode {

    /// @notice Deploy the hasher and return its address
    /// @dev Reverts if deployment fails, so a test never runs against address
    ///      zero and reads the failure as a tree bug.
    function deploy() internal returns (address hasher) {
        bytes memory code = creationCode();
        assembly {
            hasher := create(0, add(code, 0x20), mload(code))
        }
        require(hasher != address(0), "PoseidonT3Bytecode: deployment failed");
    }

